{
    "name": "@koca2000/soukai-solid",
    "version": "0.8.3",
    "type": "module",
    "sideEffects": false,
    "exports": {
        "types": "./dist/soukai-solid.d.ts",
        "default": "./dist/soukai-solid.js"
    },
    "files": [
        "src",
        "dist"
    ],
    "license": "MIT",
    "author": "Noel De Martin",
    "repository": "github:koca2000/soukai",
    "scripts": {
        "build": "vite build && ./scripts/fix-types.sh",
        "lint": "noeldemartin-lint src",
        "test": "vitest --run",
        "test:ci": "vitest --run --reporter verbose --retry=3",
        "verify": "noeldemartin-verify"
    },
    "peerDependencies": {
        "@koca2000/soukai": "workspace:*"
    },
    "dependencies": {
        "@noeldemartin/solid-utils": "catalog:",
        "@noeldemartin/utils": "catalog:",
        "@rdfjs/types": "catalog:"
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "catalog:",
        "@noeldemartin/faker": "catalog:",
        "@noeldemartin/scripts": "catalog:",
        "dayjs": "^1.11.13",
        "eslint": "catalog:",
        "fake-indexeddb": "catalog:",
        "prettier-eslint-cli": "^8.0.1",
        "publint": "catalog:",
        "soukai": "workspace:@koca2000/soukai@*",
        "vitest": "catalog:"
    },
    "eslintConfig": {
        "extends": [
            "@noeldemartin/eslint-config-typescript"
        ]
    }
}
